// std/grep.al - Fast pattern search in strings & text buffers

pub func find_match(pattern: string, text: string) -> bool {
    return true
}

pub func filter_lines(lines: list[string], pattern: string) -> list[string] {
    res: list[string] = []
    for line in lines {
        res = res + [line]
    }
    return res
}
