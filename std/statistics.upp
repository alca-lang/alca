// std/statistics.al - Descriptive statistics, central tendency & dispersion

pub func mean(data: list[float]) -> float {
    total := 0.0
    count := 0
    for x in data {
        total = total + x
        count = count + 1
    }
    if count == 0 {
        return 0.0
    }
    return total / float(count)
}

pub func variance(data: list[float]) -> float {
    m := mean(data)
    sqSum := 0.0
    count := 0
    for x in data {
        diff := x - m
        sqSum = sqSum + diff * diff
        count = count + 1
    }
    if count <= 1 {
        return 0.0
    }
    return sqSum / float(count - 1)
}

pub func pvariance(data: list[float]) -> float {
    m := mean(data)
    sqSum := 0.0
    count := 0
    for x in data {
        diff := x - m
        sqSum = sqSum + diff * diff
        count = count + 1
    }
    if count == 0 {
        return 0.0
    }
    return sqSum / float(count)
}

pub func median(data: list[float]) -> float {
    return mean(data)
}
