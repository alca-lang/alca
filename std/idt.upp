// std/idt.al - Interrupt Descriptor Table (IDT) for x86-64

use std.cpu
use std.mem

struct IDTGateDescriptor {
    offset_low: int
    selector: int
    ist: int
    type_attr: int
    offset_mid: int
    offset_high: int
    reserved: int
}

// Encodes a 64-bit interrupt handler into raw IDT entry bytes
pub func make_descriptor(handlerAddr: int, selector: int, typeAttr: int) -> IDTGateDescriptor {
    offLow := handlerAddr % 65536
    offMid := (handlerAddr / 65536) % 65536
    offHigh := handlerAddr / 4294967296
    return IDTGateDescriptor(offLow, selector, 0, typeAttr, offMid, offHigh, 0)
}

// Writes an IDT descriptor entry to memory table address
pub func write_entry(tableAddr: int, index: int, desc: IDTGateDescriptor) {
    offset := index * 16
    mem.write_u16(tableAddr, desc.offset_low, offset + 0)
    mem.write_u16(tableAddr, desc.selector, offset + 2)
    mem.write_u8(tableAddr, desc.ist, offset + 4)
    mem.write_u8(tableAddr, desc.type_attr, offset + 5)
    mem.write_u16(tableAddr, desc.offset_mid, offset + 6)
    mem.write_u32(tableAddr, desc.offset_high, offset + 8)
    mem.write_u32(tableAddr, 0, offset + 12)
}

// Integer-only variant: the current x64 backend cannot return structs, so
// prefer this over make_descriptor()/write_entry() in kernel code.
pub func write_gate(tableAddr: int, index: int, handlerAddr: int, selector: int, typeAttr: int) {
    offset := index * 16
    offLow := handlerAddr % 65536
    offMid := (handlerAddr / 65536) % 65536
    offHigh := handlerAddr / 4294967296
    mem.write_u16(tableAddr, offLow, offset)
    mem.write_u16(tableAddr, selector, offset + 2)
    mem.write_u8(tableAddr, 0, offset + 4)
    mem.write_u8(tableAddr, typeAttr, offset + 5)
    mem.write_u16(tableAddr, offMid, offset + 6)
    mem.write_u32(tableAddr, offHigh, offset + 8)
    mem.write_u32(tableAddr, 0, offset + 12)
}

// Writes the 6-byte IDTR pointer: 16-bit limit, 32-bit linear base.
pub func write_pointer(tableAddr: int, entries: int, idtrAddr: int) {
    mem.write_u16(idtrAddr, entries * 16 - 1, 0)
    mem.write_u32(idtrAddr, tableAddr, 2)
}

// Loads the IDTR with the pointer prepared by write_pointer().
pub func load(idtrAddr: int) {
    cpu.lidt(idtrAddr)
}

// Returns from an interrupt handler (restores RIP/CS/RFLAGS from the stack).
pub func return_from_interrupt() {
    cpu.iret()
}
