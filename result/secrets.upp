// std/secrets.al - Cryptographically secure random number and token generator

use std.random
use std.crypto

pub func randbelow(upper: int) -> int {
    if upper <= 0 {
        return 0
    }
    return random.randint(0, upper - 1)
}

pub func token_bytes(nbytes: int) -> string {
    res := ""
    i := 0
    loop {
        if i >= nbytes {
            break
        }
        b := random.randint(0, 255)
        res = res + chr(b)
        i = i + 1
    }
    return res
}

pub func token_hex(nbytes: int) -> string {
    return crypto.random_string(nbytes)
}

pub func token_urlsafe(nbytes: int) -> string {
    b := token_bytes(nbytes)
    return crypto.base64_encode(b)
}

pub func choice(seq: list[any]) -> any {
    if len(seq) == 0 {
        return 0
    }
    idx := random.randint(0, len(seq) - 1)
    return seq[idx]
}
