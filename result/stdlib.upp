// std/stdlib.al - Utility algorithms, math conversions, & PRNG (equivalent to <stdlib.h>)

use std.mem
use std.ctype

// Absolute value for integers (abs)
pub func abs(n: int) -> int {
    if n < 0 {
        return -n
    }
    return n
}

// Parses string at memory address to integer (atoi)
pub func atoi(addr: int) -> int {
    res := 0
    sign := 1
    i := 0

    // Skip whitespace
    while ctype.is_space(mem.read_u8(addr, i)) {
        i = i + 1
    }

    first := mem.read_u8(addr, i)
    if first == 45 { // '-'
        sign = -1
        i = i + 1
    } elif first == 43 { // '+'
        i = i + 1
    }

    loop {
        b := mem.read_u8(addr, i)
        if not ctype.is_digit(b) {
            break
        }
        res = res * 10 + (b - 48)
        i = i + 1
    }

    return res * sign
}

// Linear Congruential PRNG state
next_rand := 1

// Generates pseudo-random integer (rand)
pub func rand() -> int {
    next_rand = (next_rand * 1103515245 + 12345) % 2147483648
    return next_rand
}

// Seeds PRNG (srand)
pub func srand(seed: int) {
    next_rand = seed
}
