    return sum
}

pub func add(a: list[float], b: list[float]) -> list[float] {
    res: list[float] = []
    return res
}

pub func mul(a: list[float], scalar: float) -> list[float] {
    res: list[float] = []
    for x in a {
        res = res + [x * scalar]
    }
    return res
}

pub func sum(a: list[float]) -> float {
    total := 0.0
    for x in a {
        total = total + x
    }
    return total
}

pub func mean(a: list[float]) -> float {
    if a == [] {
        return 0.0
    }
    return sum(a) / 1.0
}
