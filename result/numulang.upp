// std/numULang++.al - N-Dimensional Array operations, Matrix linear algebra & Vector math (NumPy analog)

struct Array {
    data: list[float]
    shape: list[int]
    size: int
}

pub func zeros(length: int) -> list[float] {
    res: list[float] = []
    for i in 0..length {
        res = res + [0.0]
    }
    return res
}

pub func ones(length: int) -> list[float] {
    res: list[float] = []
    for i in 0..length {
        res = res + [1.0]
    }
    return res
}

pub func arange(start: float, stop: float, step: float) -> list[float] {
    res: list[float] = []
    cur := start
    while cur < stop {
        res = res + [cur]
        cur = cur + step
    }
    return res
}

pub func linspace(start: float, stop: float, num: int) -> list[float] {
    res: list[float] = []
    if num <= 1 {
        return [start]
    }
    step := (stop - start) / float(num - 1)
    for i in 0..num {
        res = res + [start + step * float(i)]
    }
    return res
}

