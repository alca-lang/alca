// std/vga.al - Full VGA Text Mode (80x25) Driver with Hardware Cursor & Colors

use std.cpu
use std.mem

VGA_MEM := 753664 // 0xB8000
CRTC_ADDR := 980  // 0x3D4
CRTC_DATA := 981  // 0x3D5

// VGA Colors
COLOR_BLACK := 0
COLOR_BLUE := 1
COLOR_GREEN := 2
COLOR_CYAN := 3
COLOR_RED := 4
COLOR_MAGENTA := 5
COLOR_BROWN := 6
COLOR_LIGHT_GREY := 7
COLOR_DARK_GREY := 8
COLOR_LIGHT_BLUE := 9
COLOR_LIGHT_GREEN := 10
COLOR_LIGHT_CYAN := 11
COLOR_LIGHT_RED := 12
COLOR_LIGHT_MAGENTA := 13
COLOR_LIGHT_BROWN := 14
COLOR_WHITE := 15

pub func make_color(fg: int, bg: int) -> int {
    return (bg * 16 + fg) * 256
}

pub func set_cursor(row: int, col: int) {
    pos := row * 80 + col
    // Low cursor byte to index 15
    cpu.out8(CRTC_ADDR, 15)
    cpu.out8(CRTC_DATA, pos % 256)
    // High cursor byte to index 14
    cpu.out8(CRTC_ADDR, 14)
    cpu.out8(CRTC_DATA, (pos / 256) % 256)
}

pub func put_entry_at(c: int, colorAttr: int, row: int, col: int) {
    offset := (row * 80 + col) * 2
    mem.write_u16(VGA_MEM, colorAttr + c, offset)
}

pub func clear_screen(colorAttr: int) {
    blank := colorAttr + 32 // ' '
    for i in 0..2000 {
        mem.write_u16(VGA_MEM, blank, i * 2)
    }
    set_cursor(0, 0)
}
