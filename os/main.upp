// Minimal ULang++ UEFI terminal: echo keyboard input through the firmware
// console.  Everything uses raw protocol pointers and a bump buffer carved
// out of the image's own .bss, so it stays valid when firmware relocates the
// PE image.  No heap, no strings, no runtime helpers.
use std.mem

func efi_main(image: int, systable: int) -> int {
    conin := mem.read_u64(systable, 48)
    conout := mem.read_u64(systable, 64)

    self := efi_main
    buf := self + 16384
    keybuf := self + 16896

    outfn := mem.read_u64(conout, 8)
    readfn := mem.read_u64(conin, 0)

    // Banner: "ULANG UEFI" as UTF-16.
    mem.write_u16(buf, 85, 0)
    mem.write_u16(buf, 76, 2)
    mem.write_u16(buf, 65, 4)
    mem.write_u16(buf, 78, 6)
    mem.write_u16(buf, 71, 8)
    mem.write_u16(buf, 32, 10)
    mem.write_u16(buf, 85, 12)
    mem.write_u16(buf, 69, 14)
    mem.write_u16(buf, 70, 16)
    mem.write_u16(buf, 73, 18)
    mem.write_u16(buf, 0, 20)
    outfn(conout, buf)

    mem.write_u16(buf, 32, 0)
    mem.write_u16(buf, 84, 2)
    mem.write_u16(buf, 89, 4)
    mem.write_u16(buf, 80, 6)
    mem.write_u16(buf, 69, 8)
    mem.write_u16(buf, 0, 10)
    outfn(conout, buf)

    mem.write_u16(buf, 0, 0)
    mem.write_u16(buf, 13, 2)
    mem.write_u16(buf, 10, 4)
    outfn(conout, buf)

    loop {
        readfn(conin, keybuf)
        ch := mem.read_u16(keybuf, 0)

        if ch == 13 {
            mem.write_u16(buf, 13, 0)
            mem.write_u16(buf, 10, 2)
            mem.write_u16(buf, 0, 4)
            outfn(conout, buf)
        } else {
            if ch == 8 {
                mem.write_u16(buf, 8, 0)
                mem.write_u16(buf, 32, 2)
                mem.write_u16(buf, 8, 4)
                mem.write_u16(buf, 0, 6)
                outfn(conout, buf)
            } else {
                if ch >= 32 and ch < 127 {
                    mem.write_u16(buf, ch, 0)
                    mem.write_u16(buf, 0, 2)
                    outfn(conout, buf)
                }
            }
        }
    }
    return 0
}
