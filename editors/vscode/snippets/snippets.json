{
  "Use Standard Module": {
    "prefix": "use",
    "body": [
      "use std.${1|ai,archive,cli,compress,crypto,csv,db,env,ffi,formats,gui,http,ini,io,log,math,metrics,net,path,process,re,regex,sys,time,zip|};"
    ],
    "description": "Import a standard library module"
  },
  "Import Local File": {
    "prefix": "usefile",
    "body": [
      "use \"./${1:module}.al\";"
    ],
    "description": "Import a relative Alca source file"
  },
  "Import Library": {
    "prefix": "uselib",
    "body": [
      "use ${1:library};"
    ],
    "description": "Import an APM-installed Alca library"
  },
  "Function Declaration": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:value}: ${3:int}) -> ${4:int}:",
      "    return ${5:0};"
    ],
    "description": "Declare a typed function in Alca"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "${1:inc} := |${2:x}: ${3:int}| ${2:x} + ${4:1};"
    ],
    "description": "Declare a lambda expression"
  },
  "Shell Function Declaration": {
    "prefix": "shfunc",
    "body": [
      "shfunc ${1:name}(${2:param}: ${3:string}) -> bool:",
      "    ${0:// commands are executed by the shell}",
      "    return true;"
    ],
    "description": "Declare a shell execution function in Alca"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name}:",
      "    ${2:field}: ${3:string};",
      "    ${4:active}: bool = true;"
    ],
    "description": "Declare a structure with typed fields"
  },
  "Class Declaration": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    public ${2:string}: ${3:name};",
      "",
      "    public func ${4:describe}() -> string:",
      "        return self.${3:name};"
    ],
    "description": "Declare a class with a public field and a method"
  },
  "Class with Inheritance": {
    "prefix": "classextends",
    "body": [
      "class ${1:Child} extends ${2:Parent}:",
      "    public ${3:string}: ${4:name};",
      "",
      "    public func ${5:describe}() -> string:",
      "        return super.${6:describe}() + \" \" + self.${4:name};"
    ],
    "description": "Declare a subclass that extends a parent class"
  },
  "Method": {
    "prefix": "method",
    "body": [
      "public func ${1:name}(${2:value}: ${3:int}) -> ${4:void}:",
      "    ${0:// body}"
    ],
    "description": "Declare a method inside a class body"
  },
  "Public Field": {
    "prefix": "field",
    "body": [
      "public ${1:string}: ${2:name};"
    ],
    "description": "Declare a public field inside a class or struct"
  },
  "Private Field": {
    "prefix": "fieldprivate",
    "body": [
      "private ${1:int}: ${2:count} = ${3:0};"
    ],
    "description": "Declare a private field inside a class or struct"
  },
  "Const Field": {
    "prefix": "fieldconst",
    "body": [
      "public const ${1:string}: ${2:kind} = \"${3:value}\";"
    ],
    "description": "Declare an immutable field inside a class or struct"
  },
  "Nested Struct": {
    "prefix": "nestedstruct",
    "body": [
      "public struct ${1:Point}:",
      "    ${2:x}: int;",
      "    ${3:y}: int;"
    ],
    "description": "Declare a struct nested inside a class body"
  },
  "Variable Declaration": {
    "prefix": "var",
    "body": [
      "${1:name} := ${2:42};"
    ],
    "description": "Declare a variable with type inference (:=)"
  },
  "Typed Variable Declaration": {
    "prefix": "vartype",
    "body": [
      "${1:name}: ${2:int} = ${3:0};"
    ],
    "description": "Declare a variable with an explicit type"
  },
  "Nullable Variable Declaration": {
    "prefix": "varnull",
    "body": [
      "${1:name}: ${2:string} | null = null;"
    ],
    "description": "Declare a nullable variable (T | null)"
  },
  "Public Variable": {
    "prefix": "varpublic",
    "body": [
      "public ${1:int}: ${2:name} = ${3:0};"
    ],
    "description": "Declare a binding visible to the whole program"
  },
  "Private Variable": {
    "prefix": "varprivate",
    "body": [
      "private ${1:int}: ${2:name} = ${3:0};"
    ],
    "description": "Declare a private binding inside a function, method, or struct"
  },
  "Const Variable": {
    "prefix": "varconst",
    "body": [
      "const ${1:int}: ${2:NAME} = ${3:0};"
    ],
    "description": "Declare an immutable binding"
  },
  "If Statement": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${0:// body}"
    ],
    "description": "If conditional block"
  },
  "If-Elif-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition}:",
      "    ${2:// consequence}",
      "elif ${3:other_condition}:",
      "    ${4:// other consequence}",
      "else:",
      "    ${0:// alternative}"
    ],
    "description": "If-elif-else conditional chain"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "${1:i} := 0;",
      "while ${1:i} < ${2:10}:",
      "    ${0:// body}",
      "    ${1:i} = ${1:i} + 1;"
    ],
    "description": "While loop"
  },
  "For In Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items}:",
      "    ${0:// body}"
    ],
    "description": "For-in iteration loop"
  },
  "For Range Loop": {
    "prefix": "forrange",
    "body": [
      "for ${1:i} in ${2:0}..${3:10}:",
      "    ${0:// body}"
    ],
    "description": "Numeric range loop (inclusive on both ends)"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "loop:",
      "    ${0:// body}"
    ],
    "description": "Infinite loop; leave with break"
  },
  "Match Statement": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    case ${2:1}:",
      "        ${3:// first case}",
      "    else:",
      "        ${0:// fallback}"
    ],
    "description": "Match statement with case/else arms"
  },
  "Error Raise": {
    "prefix": "err",
    "body": [
      "err(\"${1:message}\", code=${2:1});"
    ],
    "description": "Raise a runtime error with a code"
  },
  "Error Capture": {
    "prefix": "errcatch",
    "body": [
      "${1:failure}: error | null = null;",
      "${2:call_maybe_failing}() ?>>> ${1:failure};",
      "if ${1:failure} != null:",
      "    println(${1:failure}.msg);"
    ],
    "description": "Capture a runtime error into a variable (?>>>)"
  },
  "Concurrent Baroutine Block": {
    "prefix": "ba",
    "body": [
      "ba(limit=${1:4}, timeout=${2:5s}):",
      "    ${0:// concurrent work}"
    ],
    "description": "Launch a concurrent baroutine block with limits"
  },
  "Limited Baroutine Pool": {
    "prefix": "bafor",
    "body": [
      "ba(limit=${1:4}) for ${2:item} in ${3:items}:",
      "    ${0:// process item}"
    ],
    "description": "Parallel iteration with a concurrency limit"
  },
  "Threads Block": {
    "prefix": "threads",
    "body": [
      "threads:",
      "    ${0:// parallel statements}"
    ],
    "description": "Run statements on parallel threads"
  },
  "Wait Statement": {
    "prefix": "wait",
    "body": [
      "wait;"
    ],
    "description": "Wait for outstanding background work"
  },
  "Watch Block": {
    "prefix": "watch",
    "body": [
      "watch ${1:path}:",
      "    ${0:// react to changes}"
    ],
    "description": "Watch a file or resource and run a block"
  },
  "Test Block": {
    "prefix": "test",
    "body": [
      "test \"${1:Feature description}\":",
      "    value: int = 10;",
      "    assert ${2:value == 10};"
    ],
    "description": "Alca integration test block"
  },
  "Assert": {
    "prefix": "assert",
    "body": [
      "assert ${1:condition};"
    ],
    "description": "Assert a condition inside a test"
  },
  "Mock": {
    "prefix": "mock",
    "body": [
      "mock(${1:target}, ${2:replacement});"
    ],
    "description": "Replace a function or value in a test"
  },
  "Transaction": {
    "prefix": "tx",
    "body": [
      "tx(${1:connection}):",
      "    ${0:// transactional work}"
    ],
    "description": "Run a database transaction block"
  },
  "SQLite Database": {
    "prefix": "sqlite",
    "body": [
      "use std.db;",
      "",
      "conn := db.sqlite(\"${1:app.db}\");",
      "conn.exec(\"CREATE TABLE IF NOT EXISTS ${2:items} (id INTEGER PRIMARY KEY, name TEXT);\");",
      "conn.exec(\"INSERT INTO ${2:items} (name) VALUES (?);\", \"${3:Example}\");",
      "",
      "rows := conn.query(\"SELECT * FROM ${2:items};\");",
      "for row in rows:",
      "    println(row[\"name\"]);",
      "",
      "conn.close();"
    ],
    "description": "SQLite database setup and query via std.db"
  },
  "Prometheus Metrics": {
    "prefix": "metrics",
    "body": [
      "use std.metrics;",
      "",
      "${1:requests} := metrics.counter(\"${2:http_requests_total}\", \"${3:Total HTTP requests}\");",
      "${1:requests}.inc(1);",
      "",
      "println(string(metrics.export()));"
    ],
    "description": "Prometheus counter and OpenMetrics export"
  },
  "Structured Logger": {
    "prefix": "log",
    "body": [
      "use std.log;",
      "",
      "log.set_format(\"json\");",
      "log.info(\"${1:Service started}\", {\"${2:port}\": ${3:8080}});"
    ],
    "description": "Structured JSON logging via std.log"
  },
  "Decorator": {
    "prefix": "decorator",
    "body": [
      "@${1:memoize}",
      "func ${2:name}(${3:value}: ${4:int}) -> ${5:int}:",
      "    ${0:// body}"
    ],
    "description": "Attach a decorator to a function"
  }
}
