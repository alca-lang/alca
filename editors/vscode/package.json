{
  "name": "pawl-lang",
  "displayName": "Pawl Language",
  "description": "Rich language support for Pawl: full syntax highlighting, LSP completion and hover, live diagnostics, formatting, snippets, and code execution.",
  "version": "1.7.9",
  "publisher": "pawl-lang",
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "pawl",
    "language",
    "syntax",
    "lsp",
    "snippets"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pawl"
  ],
  "contributes": {
    "languages": [
      {
        "id": "pawl",
        "aliases": [
          "Pawl",
          "pawl"
        ],
        "extensions": [
          ".al"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pawl-file-light.svg",
          "dark": "./icons/pawl-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pawl",
        "scopeName": "source.al",
        "path": "./syntaxes/pawl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pawl",
        "path": "./snippets/snippets.json"
      }
    ],
    "configuration": {
      "title": "Pawl",
      "properties": {
        "pawl.executablePath": {
          "type": "string",
          "default": "pawl",
          "scope": "machine-overridable",
          "description": "Path to the Pawl CLI executable. Use an absolute path if `pawl` is not on your PATH."
        },
        "pawl.useLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Use `pawl lsp` for completion, hover, and live diagnostics when available."
        },
        "pawl.diagnostics.onOpen": {
          "type": "boolean",
          "default": true,
          "description": "Check Pawl files when they are opened (CLI fallback when the language server is unavailable)."
        },
        "pawl.diagnostics.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Check Pawl files when they are saved (CLI fallback when the language server is unavailable)."
        },
        "pawl.diagnostics.onType": {
          "type": "boolean",
          "default": true,
          "description": "Check Pawl files while typing (CLI fallback when the language server is unavailable)."
        },
        "pawl.diagnostics.delay": {
          "type": "number",
          "default": 600,
          "minimum": 200,
          "description": "Delay in milliseconds before CLI diagnostics run after a change."
        },
        "pawl.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save the active Pawl file before running, testing, checking, or building it."
        },
        "pawl.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the Pawl status bar item for .al files."
        }
      }
    },
    "commands": [
      {
        "command": "pawl.runFile",
        "title": "Pawl: Run Script (Interpreter)",
        "category": "Pawl"
      },
      {
        "command": "pawl.runFileVM",
        "title": "Pawl: Run on Bytecode VM",
        "category": "Pawl"
      },
      {
        "command": "pawl.buildFile",
        "title": "Pawl: Build Standalone Executable",
        "category": "Pawl"
      },
      {
        "command": "pawl.checkFile",
        "title": "Pawl: Check Syntax & Types",
        "category": "Pawl"
      },
      {
        "command": "pawl.testFile",
        "title": "Pawl: Run Tests",
        "category": "Pawl"
      },
      {
        "command": "pawl.fmtFile",
        "title": "Pawl: Format File",
        "category": "Pawl"
      },
      {
        "command": "pawl.repl",
        "title": "Pawl: Start REPL",
        "category": "Pawl"
      },
      {
        "command": "pawl.showOutput",
        "title": "Pawl: Show Output",
        "category": "Pawl"
      },
      {
        "command": "pawl.restartLanguageServer",
        "title": "Pawl: Restart Language Server",
        "category": "Pawl"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .al",
          "command": "pawl.runFile",
          "group": "pawl@1"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.runFileVM",
          "group": "pawl@2"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.testFile",
          "group": "pawl@3"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.buildFile",
          "group": "pawl@4"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.checkFile",
          "group": "pawl@5"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.fmtFile",
          "group": "pawl@6"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .al",
          "command": "pawl.runFile",
          "group": "pawl@1"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.testFile",
          "group": "pawl@2"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.buildFile",
          "group": "pawl@3"
        },
        {
          "when": "resourceExtname == .al",
          "command": "pawl.checkFile",
          "group": "pawl@4"
        }
      ]
    }
  }
}
