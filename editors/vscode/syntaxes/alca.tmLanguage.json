{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alca",
  "scopeName": "source.al",
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#strings" },
    { "include": "#stream_operators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#stdlib" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.al",
          "match": "//.*$"
        },
        {
          "name": "comment.block.al",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.annotation.al",
          "match": "(@[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.decorator.al" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.al",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string_escapes" }
          ]
        },
        {
          "name": "string.quoted.triple.single.al",
          "begin": "'''",
          "end": "'''",
          "patterns": [
            { "include": "#string_escapes" }
          ]
        },
        {
          "name": "string.quoted.double.al",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string_escapes" }
          ]
        },
        {
          "name": "string.quoted.single.al",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#string_escapes" }
          ]
        }
      ]
    },
    "string_escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.al",
          "match": "\\\\([ntr\"'\\\\$])"
        }
      ]
    },
    "stream_operators": {
      "patterns": [
        {
          "name": "keyword.operator.stream.al",
          "match": "(&&>>|&>>|\\?>>>|\\?>>|>>>|>>|>!|<<|\\|>)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.al",
          "match": "\\b(if|elif|else|while|for|foreach|in|loop|break|continue|return|match|case)\\b"
        },
        {
          "name": "keyword.other.declaration.al",
          "match": "\\b(func|fn|shfunc|struct|pub|use|as|import|ba|threads|wait|watch|test|mock|assert|tx|err)\\b"
        },
        {
          "name": "keyword.operator.logical.al",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.al",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.al",
          "match": "\\b(int|float|string|bool|list|map|blob|secret|json|any|error|void)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.module.al",
          "match": "\\bstd\\.(ai|archive|cli|crypto|csv|db|env|ffi|formats|gui|ini|io|log|math|metrics|net|path|process|re|regex|sys|time|zip)\\b"
        },
        {
          "name": "support.class.module.short.al",
          "match": "\\b(ai|archive|cli|crypto|csv|db|env|ffi|formats|gui|ini|io|log|math|metrics|net|path|process|re|regex|sys|time|zip)\\.(?=[a-zA-Z_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.al",
          "match": "\\b(abs|add_path|add_system_path|add_user_path|all_env|append_file|bool|broadcast_env_change|check_access|chmod|copy_file|cpu_count|delete_file|dns_lookup|download_file|exec|exec_bg|exec_cmd|exit|expand_env|file_exists|file_info|file_size|float|get_env|get_path|get_pid|get_ppid|get_system_path|get_user_path|glob|gui_alert|gui_confirm|gui_height|gui_msgbox|gui_notify|gui_open_file|gui_prompt|gui_save_file|gui_screen_size|gui_screenshot|gui_webview|gui_width|gui_window|has_path|home_dir|hostname|http_get|http_post|input|int|is_linux|is_permission_error|is_windows|json_decode|json_encode|json_prettify|json_query|kill_process|list_dir|lock_file|make_dir|max|memory_usage|min|move_file|open|os_name|path_separator|permissions|persist_user_path|ping|prepend_path|print|println|process_exists|read_file|remove_path|remove_user_path|set_env|set_path|signal_process|sleep|str_contains|str_ends_with|str_lower|str_replace|str_split|str_starts_with|str_trim|str_upper|string|temp_dir|time_now|type|typeof|unlock_file|unset_env|uptime|username|which|working_dir|write_file)\\b(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.al",
          "match": "\\b[0-9]+(\\.[0-9]+)?(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.size.al",
          "match": "\\b[0-9]+(\\.[0-9]+)?(KB|MB|GB)\\b"
        },
        {
          "name": "constant.numeric.hex.al",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.al",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.al",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.al",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.declaration.al",
          "match": "(:=)"
        },
        {
          "name": "keyword.operator.comparison.al",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.al",
          "match": "(\\+|-|\\*\\*|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.al",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arrow.al",
          "match": "(->)"
        },
        {
          "name": "keyword.operator.range.al",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.pipe.al",
          "match": "(\\|)"
        },
        {
          "name": "keyword.operator.timeout.al",
          "match": "(~)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.al",
          "match": "\\b(func|shfunc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.al" },
            "2": { "name": "entity.name.function.al" }
          }
        },
        {
          "name": "meta.struct.declaration.al",
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.al" },
            "2": { "name": "entity.name.type.class.al" }
          }
        },
        {
          "name": "entity.name.function.call.al",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.al",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
