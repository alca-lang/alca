{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Alca",
  "scopeName": "source.al",
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#strings" },
    { "include": "#stream_operators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#stdlib" },
    { "include": "#builtins" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.al",
          "match": "//.*$"
        },
        {
          "name": "comment.block.al",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.annotation.al",
          "match": "(@[a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.decorator.al" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.al",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string_escapes" },
            { "include": "#string_interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.al",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string_escapes" },
            { "include": "#string_interpolation" }
          ]
        }
      ]
    },
    "string_escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.al",
          "match": "\\\\([nrtvfb\\\\\"'0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "string_interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.al",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.al" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.al" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "stream_operators": {
      "patterns": [
        {
          "name": "keyword.operator.stream.al",
          "match": "(&&>>|&>>|\\?>>>|\\?>>|>>>|>>|>!|<<|\\|>)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.al",
          "match": "\\b(if|elif|else|while|for|foreach|in|loop|break|continue|return|match|case)\\b"
        },
        {
          "name": "keyword.other.declaration.al",
          "match": "\\b(func|shfunc|struct|pub|use|as|ba|threads|wait|watch|test|mock|assert|tx|err|import)\\b"
        },
        {
          "name": "keyword.operator.logical.al",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.al",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.al",
          "match": "\\b(int|float|string|bool|list|map|blob|secret|json)\\b"
        }
      ]
    },
    "stdlib": {
      "patterns": [
        {
          "name": "support.class.module.al",
          "match": "\\bstd\\.(db|sqlite|postgres|metrics|log|crypto|gui|math|time|io|net|path|regex|re|archive|zip|formats|csv|ini|sys|process|env|cli)\\b"
        },
        {
          "name": "support.class.module.short.al",
          "match": "\\b(sqlite|postgres|metrics|crypto|gui|math|time|io|net|path|re|archive|formats|process)\\.(?=[a-zA-Z_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.al",
          "match": "\\b(print|println|len|type|typeof|int|float|string|bool|list|append|pop|push|keys|values|range|sleep|exit|input|json_encode|json_decode|abs|max|min|time_now|env|set_env|exec)\\b(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.al",
          "match": "\\b[0-9]+(\\.[0-9]+)?(ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.size.al",
          "match": "\\b[0-9]+(\\.[0-9]+)?(KB|MB|GB)\\b"
        },
        {
          "name": "constant.numeric.hex.al",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.al",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.al",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.al",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.al",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.al",
          "match": "(\\+|-|\\*\\*|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.al",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.arrow.al",
          "match": "(->)"
        },
        {
          "name": "keyword.operator.range.al",
          "match": "(\\.\\.)"
        },
        {
          "name": "keyword.operator.pipe.al",
          "match": "(\\|)"
        },
        {
          "name": "keyword.operator.timeout.al",
          "match": "(~)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.declaration.al",
          "match": "\\b(func|shfunc)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.al" },
            "2": { "name": "entity.name.function.al" }
          }
        },
        {
          "name": "meta.struct.declaration.al",
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.struct.al" },
            "2": { "name": "entity.name.type.class.al" }
          }
        },
        {
          "name": "entity.name.function.call.al",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.al",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
